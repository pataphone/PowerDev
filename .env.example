# --- Discord (Developer Portal -> your application) ---
DISCORD_TOKEN=
APP_ID=
# Server to register slash commands on (instant). Leave empty to register globally (slow to propagate).
GUILD_ID=

# --- Access control ---
# Comma-separated Discord user IDs that are ALWAYS admins (at least put your own ID here).
OWNER_IDS=

# --- HTTP API (optional) ---
# The API is only started when API_KEY is set. Clients send it in the X-API-Key header.
API_KEY=
# Render sets PORT automatically. Locally it defaults to 3000.
PORT=3000

# --- Storage ---
# Path to the SQLite file. On Render, point this at a persistent disk.
DB_PATH=ideas.db
